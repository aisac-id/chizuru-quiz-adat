# Local tooling only — no runtime secrets in this static game.
# Copy to .env (gitignored) and adjust as needed. Never commit real values.

# Port for the local static server used by e2e tests (scripts/serve.mjs)
PORT=8123

# Host for the local static server and the default test base URL
HOST=127.0.0.1

# Base URL for Playwright e2e tests (defaults to http://$HOST:$PORT)
BASE_URL=http://127.0.0.1:8123